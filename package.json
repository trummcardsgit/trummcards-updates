{
  "name": "trummcards-lagerverwaltung",
  "version": "1.6.0",
  "private": true,
  "description": "TrummCards Lagerverwaltung fuer Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm run check && electron-builder --win nsis --publish never",
    "check": "node scripts/check-config.js && node --check main.js && node --check preload.js"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "at.trummcards.lagerverwaltung",
    "productName": "TrummCards Lagerverwaltung",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/trummcards.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TrummCards Lagerverwaltung"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "trummcardsgit",
        "repo": "trummcards-updates",
        "releaseType": "release"
      }
    ],
    "artifactName": "TrummCards-Lagerverwaltung-Setup-${version}.${ext}"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
