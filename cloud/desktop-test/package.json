{
  "name": "trummcards-cloud-test",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated TrummCards cloud test application (not the production inventory)",
  "main": "main.cjs",
  "scripts": {
    "start": "npm run bundle && electron .",
    "bundle": "node scripts/bundle.mjs",
    "check": "node --check main.cjs && node --check src/app.js && node --check src/logic.js && node --test tests/*.test.cjs",
    "dist": "npm run bundle && npm run check && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "at.trummcards.cloudtest",
    "productName": "TrummCards Cloud TEST",
    "directories": { "output": "dist" },
    "files": [
      "main.cjs",
      "src/index.html",
      "src/styles.css",
      "src/app.js",
      "src/logic.js",
      "src/vendor.js",
      "assets/**/*",
      "package.json"
    ],
    "win": { "target": ["nsis"], "icon": "assets/cloud-test.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TrummCards Cloud TEST",
      "createStartMenuShortcut": true
    },
    "publish": null,
    "artifactName": "TrummCards-Cloud-TEST-${version}-Setup.${ext}"
  }
}
